rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
             (!('sevaCategory' in data) || (data.sevaCategory is string && data.sevaCategory.size() <= 80)) &&
             (!('preferredLanguage' in data) || (data.preferredLanguage is string && data.preferredLanguage.size() <= 10));
    }

    function isValidSevaPledge(data) {
      return data.pledgeId is string && data.pledgeId.size() >= 1 && data.pledgeId.size() <= 64 &&
             data.userId == request.auth.uid &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidNotificationLog(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 2000 &&
             data.targetScreen is string && data.targetScreen.size() >= 1 && data.targetScreen.size() <= 80 &&
             data.status is string && data.status.size() >= 1 && data.status.size() <= 50;
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();

      allow create: if isValidUserProfile(incoming());

      allow update: if isOwner(userId) && isValidUserProfile(incoming());

      allow delete: if isOwner(userId);

      match /pledges/{pledgeId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(pledgeId) &&
                         incoming().keys().hasAll(['pledgeId', 'userId', 'category', 'createdAt']) &&
                         isValidSevaPledge(incoming());

        allow update: if isOwner(userId) &&
                         incoming().pledgeId == existing().pledgeId &&
                         isValidSevaPledge(incoming());

        allow delete: if isOwner(userId);
      }
    }

    match /notification_logs/{logId} {
      allow read: if true;
      allow create: if isValidNotificationLog(incoming());
      allow update, delete: if isSignedIn();
    }
  }
}
